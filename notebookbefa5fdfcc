{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.15","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"competition","sourceId":139732}],"isInternetEnabled":false,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"source":"<a href=\"https://www.kaggle.com/code/harigov63/notebookbefa5fdfcc?scriptVersionId=356683781\" target=\"_blank\"><img align=\"left\" alt=\"Kaggle\" title=\"Open in Kaggle\" src=\"https://kaggle.com/static/images/open-in-kaggle.svg\"></a>","metadata":{},"cell_type":"markdown"},{"cell_type":"code","source":"# This Python 3 environment comes with many helpful analytics libraries installed\n# It is defined by the kaggle/python Docker image: https://github.com/kaggle/docker-python\n# For example, here's several helpful packages to load\n\nimport numpy as np # linear algebra\nimport pandas as pd # data processing, CSV file I/O (e.g. pd.read_csv)\n\n# Input data files are available in the read-only \"../input/\" directory\n# For example, running this (by clicking run or pressing Shift+Enter) will list all files under the input directory\n\nimport os\nfor dirname, _, filenames in os.walk('/kaggle/input'):\n    for filename in filenames:\n        print(os.path.join(dirname, filename))\n\n# You can write up to 20GB to the current directory (/kaggle/working/) that gets preserved as output when you create a version using \"Save & Run All\" \n# You can also write temporary files to /kaggle/temp/, but they won't be saved outside of the current session\n\n# Use the kagglehub client library to attach Kaggle resources like competitions, datasets, and models to your session\n# Learn more about kagglehub: https://github.com/Kaggle/kagglehub/blob/main/README.md\n\nimport kagglehub\n# kagglehub.dataset_download('<owner>/<dataset-slug>')","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import os\nimport gc\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import Dataset, DataLoader\nfrom PIL import Image\nimport torchvision.transforms as transforms\nfrom sklearn.model_selection import KFold\nfrom torchvision.models import efficientnet_b4, EfficientNet_B4_Weights\n\nprint(f\"PyTorch Version: {torch.__version__}\")\nprint(f\"CUDA Available: {torch.cuda.is_available()}\")\n\n# --- 1. PIPELINE RUNTIME CONFIGURATION ---\nDEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nBATCH_SIZE = 32\nEPOCHS = 12                     # Increase to 20-30 for better performance on full runs\nLEARNING_RATE = 2e-4\nIMG_SIZE = 384                  # Matches optimal resolution for EfficientNet-B4 texture tracking\nNUM_WORKERS = 4\nSEED = 42\n\n# Define target support points matching DIN EN ISO 14688-1\nSUPPORT_POINTS = np.array([0.002, 0.0063, 0.02, 0.063, 0.2, 0.63, 2.0, 6.3, 20.0, 63.0, 200.0])\nLOG_SP = np.log10(SUPPORT_POINTS)\n# Logarithmic interval lengths used directly for metric weighing\nINTERVAL_WEIGHTS = torch.tensor(LOG_SP[1:] - LOG_SP[:-1], dtype=torch.float32).to(DEVICE)\n\n# --- 2. COMPETITION CUSTOM LOG-WEIGHTED EMD LOSS ---\nclass LogWeightedEMDLoss(nn.Module):\n    def __init__(self, interval_weights):\n        super(LogWeightedEMDLoss, self).__init__()\n        self.interval_weights = interval_weights\n\n    def forward(self, y_pred, y_true):\n        # Scale inputs down to fractions [0.0, 1.0] for optimization stability\n        pred_frac = y_pred / 100.0\n        true_frac = y_true / 100.0\n        \n        diff = torch.abs(pred_frac - true_frac)\n        # Trapezoidal area calculations across the 10 distribution intervals\n        interval_errors = (diff[:, :-1] + diff[:, 1:]) / 2.0\n        \n        # Apply logarithmic scale segment weights\n        emd = torch.sum(interval_errors * self.interval_weights, dim=1)\n        return torch.mean(emd) * 500.0  # Scales to [0, 500] limit boundary\n\n# --- 3. DATASET WRAPPER (Handles labels vs inferences safely) ---\nclass SoilDataset(Dataset):\n    def __init__(self, df, img_dir, transform=None, is_test=False):\n        self.df = df.reset_index(drop=True)\n        self.img_dir = img_dir\n        self.transform = transform\n        self.is_test = is_test\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        row = self.df.iloc[idx]\n        img_name = f\"{row['sample_id']}.jpg\"\n        img_path = os.path.join(self.img_dir, img_name)\n        \n        # Safe image reader pipeline fallback\n        try:\n            image = Image.open(img_path).convert(\"RGB\")\n        except Exception:\n            image = Image.new(\"RGB\", (IMG_SIZE, IMG_SIZE), (128, 128, 128))\n            \n        if self.transform:\n            image = self.transform(image)\n            \n        if self.is_test:\n            return image, row['sample_id']\n            \n        # Target cumulative distributions mapped to text labels\n        targets = row[SUPPORT_POINTS.astype(str).tolist()].values.astype(np.float32)\n        return image, torch.tensor(targets)\n\n# --- 4. PREPROCESSING & STABLE IMAGERY DATA AUGMENTATIONS ---\ntrain_transforms = transforms.Compose([\n    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n    transforms.RandomHorizontalFlip(),\n    transforms.RandomVerticalFlip(),\n    transforms.RandomRotation(15),\n    transforms.ColorJitter(brightness=0.15, contrast=0.15),\n    transforms.ToTensor(),\n    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),\n])\n\nval_transforms = transforms.Compose([\n    transforms.Resize((IMG_SIZE, IMG_SIZE)),\n    transforms.ToTensor(),\n    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),\n])\n\n# --- 5. MONOTONIC VALIDATION GUARANTEED DEEP NEURAL NETWORK ---\nclass SoilGranulometryModel(nn.Module):\n    def __init__(self):\n        super(SoilGranulometryModel, self).__init__()\n        weights = EfficientNet_B4_Weights.DEFAULT\n        self.backbone = efficientnet_b4(weights=weights)\n        \n        in_features = self.backbone.classifier.in_features\n        self.backbone.classifier = nn.Identity()\n        \n        self.head = nn.Sequential(\n            nn.Linear(in_features, 512),\n            nn.ReLU(),\n            nn.Dropout(0.25),\n            nn.Linear(512, 10) # 10 discrete mass bins between our 11 support metrics\n        )\n\n    def forward(self, x):\n        features = self.backbone(x)\n        # Softmax forces fractions to always sum to exactly 1.0 (100% total mass)\n        bin_fractions = torch.softmax(self.head(features), dim=1)\n        \n        # Cumulative sum mathematically guarantees a non-decreasing monotonic line\n        cumsum = torch.cumsum(bin_fractions, dim=1) * 100.0\n        \n        # Format mapping matrix configuration grid [batch_size, 11]\n        out = torch.zeros(x.size(0), 11).to(x.device)\n        out[:, 1:] = cumsum # The first point is bounded starting from 0 base index updates\n        return out\n\n# --- 6. UNIFIED CROSS-VALIDATED ENGINE AND FILE EXPORTER --- \ndef train_and_submit():\n    # Absolute paths verified from your active Kaggle Input storage panel\n    TRAIN_CSV = \"/kaggle/input/soil-grain-size-from-photos/Training_labels_updated.csv\"\n    TEST_CSV = \"/kaggle/input/soil-grain-size-from-photos/sample_submission.csv\"\n    TRAIN_IMG_DIR = \"/kaggle/input/soil-grain-size-from-photos/Training-All_Photos_updated/Training-All_Photos_updated\"\n    TEST_IMG_DIR = \"/kaggle/input/soil-grain-size-from-photos/Test_All_Photos/Test_All_Photos\"\n\n    if not os.path.exists(TRAIN_CSV):\n        print(\"⚠️ Data paths not found at Kaggle root! Please ensure dataset is correctly bound.\")\n        return\n\n    train_df = pd.read_csv(TRAIN_CSV)\n    test_df = pd.read_csv(TEST_CSV)\n    \n    kf = KFold(n_splits=5, shuffle=True, random_state=SEED)\n    saved_model_paths = []\n    \n    criterion = LogWeightedEMDLoss(INTERVAL_WEIGHTS)\n    \n    # 5-Fold Cross Validation Loop Execution Block\n    for fold, (train_idx, val_idx) in enumerate(kf.split(train_df)):\n        print(f\"\\n======== 🔥 STARTING DATA WRAPPING FOLD {fold + 1}/5 ========\")\n        \n        fold_train_df = train_df.iloc[train_idx]\n        fold_val_df = train_df.iloc[val_idx]\n        \n        train_ds = SoilDataset(fold_train_df, TRAIN_IMG_DIR, transform=train_transforms)\n        val_ds = SoilDataset(fold_val_df, TRAIN_IMG_DIR, transform=val_transforms)\n        \n        train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True, num_workers=NUM_WORKERS, pin_memory=True)\n        val_loader = DataLoader(val_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS, pin_memory=True)\n        \n        model = SoilGranulometryModel().to(DEVICE)\n        optimizer = optim.AdamW(model.parameters(), lr=LEARNING_RATE, weight_decay=1e-4)\n        scheduler = optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=EPOCHS)\n        \n        best_val_loss = float('inf')\n        fold_model_path = f\"best_model_fold_{fold}.pth\"\n        \n        for epoch in range(EPOCHS):\n            # Training Cycle\n            model.train()\n            train_loss = 0.0\n            for images, targets in train_loader:\n                images, targets = images.to(DEVICE), targets.to(DEVICE)\n                optimizer.zero_grad()\n                outputs = model(images)\n                loss = criterion(outputs, targets)\n                loss.backward()\n                optimizer.step()\n                train_loss += loss.item() * images.size(0)\n            \n            scheduler.step()\n            train_loss /= len(train_loader.dataset)\n            \n            # Validation Cycle\n            model.eval()\n            val_loss = 0.0\n            with torch.no_grad():\n                for images, targets in val_loader:\n                    images, targets = images.to(DEVICE), targets.to(DEVICE)\n                    outputs = model(images)\n                    loss = criterion(outputs, targets)\n                    val_loss += loss.item() * images.size(0)\n            val_loss /= len(val_loader.dataset)\n            \n            print(f\"Epoch {epoch+1:02d}/{EPOCHS:02d} | Train Loss: {train_loss:.4f} | Val Loss: {val_loss:.4f}\")\n            \n            if val_loss < best_val_loss:\n                best_val_loss = val_loss\n                torch.save(model.state_dict(), fold_model_path)\n                \n        print(f\"✨ Fold {fold + 1} completed! Best Validation Score: {best_val_loss:.4f}\")\n        saved_model_paths.append(fold_model_path)\n        \n        # Free up memory before initializing the next fold iteration\n        del model, optimizer, train_loader, val_loader\n        torch.cuda.empty_cache()\n        gc.collect()\n\n    # --- 7. MULTI-MODEL ENSEMBLE TEST DATA INFERENCE ---\n    print(\"\\n🔮 Beginning Test Set Inference using Fold Ensemble Model weights...\")\n    test_ds = SoilDataset(test_df, TEST_IMG_DIR, transform=val_transforms, is_test=True)\n    test_loader = DataLoader(test_ds, batch_size=BATCH_SIZE, shuffle=False, num_workers=NUM_WORKERS)\n    \n    ensemble_models = []\n    for path in saved_model_paths:\n        m = SoilGranulometryModel().to(DEVICE)\n        m.load_state_dict(torch.load(path))\n        m.eval()\n        ensemble_models.append(m)\n        \n    all_preds, all_ids = [], []\n    \n    with torch.no_grad():\n        for images, ids in test_loader:\n            images = images.to(DEVICE)\n            fold_outputs = torch.zeros(images.size(0), 11).to(DEVICE)\n            \n            for m in ensemble_models:\n                fold_outputs += m(images)\n            fold_outputs /= len(ensemble_models)\n            \n            all_preds.append(fold_outputs.cpu().numpy())\n            all_ids.extend(ids)\n            \n    final_pred_matrix = np.vstack(all_preds)\n    col_names = ['0.002', '0.0063', '0.02', '0.063', '0.2', '0.63', '2.0', '6.3', '20.0', '63.0', '200.0']\n    \n    submission_df = pd.DataFrame(final_pred_matrix, columns=col_names)\n    submission_df.insert(0, 'sample_id', all_ids)\n  \n# Absolute rule validation layer right before generating submission\nfor i in range(1, len(col_names)):\nsubmission_df[col_names[i]] = np.maximum(submission_df[col_names[i]], submission_df[col_names[i-1]])\nsubmission_df[col_names[-1]] = 100.00 # The value at 200 mm must be exactly 100.00\n# Ensure match syntax matches file headers perfectly\nsubmission_df.columns = ['sample_id', '0.002', '0.0063', '0.02', '0.063', '0.2', '0.63', '2.0', '6.3', '20', '63', '200']\nsubmission_df.to_csv(\"submission.csv\", index=False)\nprint(\"\\n🎉 SUCCESS! Full submission.csv pipeline built successfully!\")\nif name == \"main\":\ntrain_and_submit()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-09T08:18:24.528758Z","iopub.execute_input":"2026-10-09T08:18:24.529577Z","iopub.status.idle":"2026-10-09T08:18:24.557109Z","shell.execute_reply.started":"2026-10-09T08:18:24.529553Z","shell.execute_reply":"2026-10-09T08:18:24.55597Z"}},"outputs":[{"traceback":["\u001b[0;36m  File \u001b[0;32m\"/tmp/ipykernel_49/2693797373.py\"\u001b[0;36m, line \u001b[0;32m245\u001b[0m\n\u001b[0;31m    submission_df[col_names[i]] = np.maximum(submission_df[col_names[i]], submission_df[col_names[i-1]])\u001b[0m\n\u001b[0m    ^\u001b[0m\n\u001b[0;31mIndentationError\u001b[0m\u001b[0;31m:\u001b[0m expected an indented block after 'for' statement on line 244\n"],"ename":"IndentationError","evalue":"expected an indented block after 'for' statement on line 244 (2693797